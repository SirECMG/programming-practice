#include <iostream>
#include <vector>

int main() {

    std::vector<int> v(1000001, 0);
    
    int n;
    std::cin >> n;

    int i = 0;
    while ( i < n ) {
        int arrows_used = 0;

        int cur_height;
        std::cin >> cur_height;

        if(v[cur_height] == 0) {
            arrows_used++;
            v[cur_height - 1]++;
        } else {
            v[cur_height]--;
            v[cur_height - 1]++;
        }
        std::cout << "arrows_used: " << arrows_used << "\n";
        ++i;
    }



    return 0;
}
